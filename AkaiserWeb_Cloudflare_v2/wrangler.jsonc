{
  "name": "akaiser-account",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "akaiser-db" }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "MAX_DEVICES": "5", "GACHA_UTC_OFFSET_MIN": "0" }
}
